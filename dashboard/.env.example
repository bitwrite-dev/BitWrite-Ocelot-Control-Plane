# Copy to .env.local and adjust. .env* is gitignored.

# Origin the API is served from, as seen by the browser.
#
# Leave this EMPTY for same-origin requests: resource paths are full API paths
# (/api/v1/...), so the browser requests them directly and the Vite dev server's
# /api proxy forwards them. The API then needs no CORS.
#
# This must be an ORIGIN, never a path prefix. A prefix such as "/api" is
# concatenated with the "/api/..." already in every path and produces
# /api/api/v1/... — which 404s.
#
# Set an absolute origin only for a cross-origin deployment, e.g.
# https://api.example.com
VITE_API_BASE_URL=

# The environment the dashboard operates on, sent as X-Environment on every request.
#
# REQUIRED. Routes, services and snapshots are stored per environment, and a request
# that names none is rejected rather than answered with some default's data — which
# would look like an empty or someone else's configuration rather than a mistake.
#
# Must match the environment the API is configured with (its `Environment` setting),
# because that is the environment whose published snapshots the API applies.
VITE_API_ENVIRONMENT=development

# Where the Vite dev server proxies /api requests to.
# Matches the `http` profile in
# src/BitWrite.OcelotControl.Api/Properties/launchSettings.json
VITE_DEV_API_TARGET=http://localhost:5039
