{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      // shadcn/ui components are vendored into the repo and regenerated by
      // `npx shadcn@latest add`. Several export their cva variants alongside the
      // component, which trips the fast-refresh rule. Editing the generated file
      // would be lost on the next `add`, so suppress the rule here instead.
      "files": ["src/components/ui/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
