{
  // No "Environment" here on purpose. It names the environment this installation
  // serves to background work, which has no request to name one, and a value here
  // would be inherited by every deployment — including production containers that
  // would then read development keys. Set it per environment; a startup warning
  // says so when it is missing.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
